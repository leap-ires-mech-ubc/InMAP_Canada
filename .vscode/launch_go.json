{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch test function",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${workspaceFolder}",
            "debugAdapter": "dlv-dap",
            
            "args": [
                "-test.run",
                "MyTestFunction"
            ]
            
        },
        {
            "name": "Launch Package",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${fileDirname}"
        }
    ],

    "dlvFlags": [
        "--check-go-version=false"
    ],

    "go.delveConfig": [
        {
        "debugAdapter": "legacy"
 }
]
}